# API
GRAPHQL_GATEWAY_PORT=8023
GRAPHQL_GATEWAY_WORKERS=4

# Redis
REDIS_URL=redis://:redis_secret_2026@medtrust-redis:6379/0

# Keycloak
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=medtrustx
KEYCLOAK_CLIENT_ID=graphql-gateway-client
KEYCLOAK_CLIENT_SECRET=secret

# Composition Gateway
COMPOSITION_GATEWAY_URL=http://api-composition-gateway:8022

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=graphql-federation-gateway

# Security
PQC_SESSION_HEADER=X-PQC-Session-Key
