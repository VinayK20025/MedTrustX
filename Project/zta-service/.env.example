# API
ZTA_SERVICE_PORT=8012
ZTA_SERVICE_WORKERS=4

# PostgreSQL (IAM DB)
IAM_DB_URL=postgresql+asyncpg://medtrust_iam_admin:iam_db_secret_2026@pg-iam:5434/iam_db

# Redis
REDIS_URL=redis://:redis_secret_2026@medtrust-redis:6379/0

# Keycloak
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=medtrustx

# OPA
OPA_URL=http://opa-service:8181
OPA_POLICY_PATH=/v1/data/medtrust/authz/allow

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=zta-service

# Security
PQC_SESSION_HEADER=X-PQC-Session-Key
