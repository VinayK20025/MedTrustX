# =============================================================================
# MedTrustX AI Platform Service — Environment Variables Example
# =============================================================================
# Copy this file to .env and fill in production values.
# NEVER commit the actual .env file to version control.
# All variables listed here are REQUIRED unless marked [OPTIONAL].
# =============================================================================

# ─── Service Identity ─────────────────────────────────────────────────────────
SERVICE_NAME=ai-platform-service
SERVICE_VERSION=1.0.0
ENVIRONMENT=development
# One of: debug | info | warning | error | critical
LOG_LEVEL=info
# Port the FastAPI uvicorn server listens on inside the container
SERVICE_PORT=8010

# ─── PostgreSQL — Analytics DB ───────────────────────────────────────────────
# Host inside the Docker Compose medtrust-data network
ANALYTICS_DB_HOST=medtrust-pg-analytics
ANALYTICS_DB_PORT=5435
ANALYTICS_DB_NAME=analytics_db
ANALYTICS_DB_USER=medtrust_analytics_admin
ANALYTICS_DB_PASSWORD=analytics_db_secret_2026
# SQLAlchemy async DSN (assembled from above at startup)
# Leave blank — config.py constructs it automatically.
# ANALYTICS_DB_DSN=postgresql+asyncpg://user:pass@host:port/db
# Connection pool sizing
ANALYTICS_DB_POOL_SIZE=10
ANALYTICS_DB_MAX_OVERFLOW=20
# Per-query timeout in seconds (enforced via asyncio.wait_for)
ANALYTICS_DB_QUERY_TIMEOUT=5

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=medtrust-redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret_2026
# Database index (0 = default)
REDIS_DB=2
# Full URL assembled automatically — override only if needed
# REDIS_URL=redis://:password@host:port/db
# Pub/Sub channel for real-time anomaly broadcasts
REDIS_ANOMALY_CHANNEL=medtrust:ai:anomalies
# Feature vector cache TTL in seconds (15 minutes)
FEATURE_CACHE_TTL=900
# Analytics response cache TTL in seconds (5 minutes)
ANALYTICS_CACHE_TTL=300

# ─── TensorFlow Serving ───────────────────────────────────────────────────────
TF_SERVING_HOST=tf-serving-service
TF_SERVING_REST_PORT=8501
# REST base URL used by the service
TF_SERVING_URL=http://tf-serving-service:8501
# Per-request timeout in seconds before falling back to rule-based scoring
TF_SERVING_TIMEOUT=3
# Model names registered in TF Serving
TF_MODEL_READMISSION=readmission
TF_MODEL_ANOMALY=vitals_anomaly
TF_MODEL_DIAGNOSE=diagnose_risk

# ─── MLflow ───────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow-service:5000
# S3/MinIO artifact store accessible from this container [OPTIONAL]
MLFLOW_ARTIFACT_ROOT=s3://ml-models
# AWS / MinIO credentials for MLflow artifact access [OPTIONAL]
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=medtrust_minio_admin
AWS_SECRET_ACCESS_KEY=minio_secret_2026

# ─── Keycloak / Auth ─────────────────────────────────────────────────────────
# Realm used for MedTrustX tokens
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=medtrustx
# JWKS endpoint (assembled automatically from URL + realm)
# KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/medtrustx/protocol/openid-connect/certs
# JWT audience claim expected in every token
JWT_AUDIENCE=medtrustx-ai-platform
# JWT algorithm — MUST be RS256 (asymmetric)
JWT_ALGORITHM=RS256
# JWKS in-memory cache refresh interval in seconds (5 minutes)
JWKS_CACHE_TTL=300
# Claim names inside the JWT payload
JWT_TENANT_CLAIM=tenant_id
JWT_USER_CLAIM=sub
JWT_ROLE_CLAIM=realm_access

# ─── Post-Quantum Cryptography (PQC) — Kyber-768 ────────────────────────────
# Enable PQC hybrid validation layer on top of RS256
PQC_ENABLED=true
# KEM algorithm name as supported by liboqs
PQC_KEM_ALGORITHM=Kyber768
# Path to the PQC public key used to verify the encapsulated session key.
# In production, mount this from Vault or a Kubernetes secret.
PQC_PUBLIC_KEY_PATH=/run/secrets/pqc_kyber_public.key
# Shared-secret header name injected by the API gateway after KEM decapsulation
PQC_SESSION_HEADER=X-PQC-Session-Key

# ─── OpenTelemetry / Jaeger ───────────────────────────────────────────────────
OTEL_ENABLED=true
OTEL_SERVICE_NAME=medtrust-ai-platform
# OTLP HTTP collector endpoint (Jaeger all-in-one)
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:14268/api/traces
# Sampling ratio (1.0 = 100% in dev; tune down in prod)
OTEL_TRACE_SAMPLE_RATE=1.0

# ─── Prometheus ───────────────────────────────────────────────────────────────
# Metrics are exposed at GET /metrics (Prometheus scrape target)
# No additional config needed — prometheus-client auto-registers.
PROMETHEUS_METRICS_PATH=/metrics

# ─── Loki (Structured Logging) ────────────────────────────────────────────────
LOKI_ENABLED=true
LOKI_URL=http://loki:3100/loki/api/v1/push
# Batch size before flushing log entries to Loki
LOKI_BATCH_SIZE=10
# Flush interval in seconds
LOKI_FLUSH_INTERVAL=5

# ─── Multi-Tenancy ────────────────────────────────────────────────────────────
# Comma-separated list of valid tenant IDs (used for JWT claim validation)
VALID_TENANT_IDS=tenant_apollo,tenant_medanta,tenant_aiims
# PostgreSQL session variable set before every query (leverages RLS)
PG_TENANT_SESSION_VAR=app.tenant_id

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins [OPTIONAL — * in dev only]
CORS_ORIGINS=http://localhost:3000,http://143.244.137.224:3000

# ─── Feature Engineering ─────────────────────────────────────────────────────
# Lookback window for readmission feature computation (days)
READMISSION_LOOKBACK_DAYS=90
# Anomaly Z-score threshold
ANOMALY_ZSCORE_THRESHOLD=2.5
# Default vitals anomaly lookback (hours)
ANOMALY_LOOKBACK_HOURS=24

# ─── WebSocket ────────────────────────────────────────────────────────────────
# Number of past anomaly events streamed to a client on connect
WS_HISTORY_EVENTS=10
# Ping interval to keep connections alive (seconds)
WS_PING_INTERVAL=30
# Maximum concurrent WebSocket connections
WS_MAX_CONNECTIONS=500

# ─── Rate Limiting [OPTIONAL] ────────────────────────────────────────────────
# Requests per minute per IP (enforced in middleware)
RATE_LIMIT_PER_MINUTE=120
