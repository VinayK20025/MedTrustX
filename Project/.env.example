# ============================================================
# MedTrustX DHOS — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ─── Global ──────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=medtrust
ENVIRONMENT=development
LOG_LEVEL=debug
TZ=Asia/Kolkata

# ─── Multi-Tenancy ──────────────────────────────────────────
TENANT_IDS=tenant_hospital1,tenant_hospital2
DEFAULT_TENANT_ID=tenant_hospital1

# ─── JWT / Auth ─────────────────────────────────────────────
JWT_SECRET=<CHANGE_ME_RANDOM_SECRET>
JWT_EXPIRY=3600
JWT_REFRESH_EXPIRY=86400
JWT_ISSUER=medtrust-iam

# ─── PostgreSQL Instances ───────────────────────────────────
PG_CLINICAL_USER=<CHANGE_ME>
PG_CLINICAL_PASSWORD=<CHANGE_ME>
PG_OPERATIONAL_USER=<CHANGE_ME>
PG_OPERATIONAL_PASSWORD=<CHANGE_ME>
PG_IAM_USER=<CHANGE_ME>
PG_IAM_PASSWORD=<CHANGE_ME>
PG_ANALYTICS_USER=<CHANGE_ME>
PG_ANALYTICS_PASSWORD=<CHANGE_ME>
PG_TELEMED_USER=<CHANGE_ME>
PG_TELEMED_PASSWORD=<CHANGE_ME>

# ─── Redis ──────────────────────────────────────────────────
REDIS_PASSWORD=<CHANGE_ME>

# ─── Kong Gateway ──────────────────────────────────────────
KONG_PROXY_PORT=8000
KONG_PROXY_SSL_PORT=8443
KONG_ADMIN_PORT=8001

# ─── Keycloak ───────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=<CHANGE_ME>
KC_DB_URL=jdbc:postgresql://pg-iam:5434/keycloak_db
KC_DB_USERNAME=<CHANGE_ME>
KC_DB_PASSWORD=<CHANGE_ME>
KC_REALM=medtrust

# ─── Vault ──────────────────────────────────────────────────
VAULT_DEV_ROOT_TOKEN_ID=<CHANGE_ME>
VAULT_ADDR=http://vault:8200

# ─── MinIO ──────────────────────────────────────────────────
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=<CHANGE_ME>
MINIO_ROOT_PASSWORD=<CHANGE_ME>

# ─── ClickHouse ────────────────────────────────────────────
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_USER=<CHANGE_ME>
CLICKHOUSE_PASSWORD=<CHANGE_ME>

# ─── OpenSearch ────────────────────────────────────────────
OPENSEARCH_INITIAL_ADMIN_PASSWORD=<CHANGE_ME>

# ─── Orthanc ──────────────────────────────────────────────
ORTHANC_PASSWORD=<CHANGE_ME>

# ─── EMQX ─────────────────────────────────────────────────
EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASSWORD=<CHANGE_ME>

# ─── Jitsi ─────────────────────────────────────────────────
JITSI_HTTPS_PORT=8443
JICOFO_AUTH_PASSWORD=<CHANGE_ME>
JVB_AUTH_PASSWORD=<CHANGE_ME>
JITSI_TIMEZONE=Asia/Kolkata
COTURN_SECRET=<CHANGE_ME>

# ─── Monitoring ───────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3100
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=<CHANGE_ME>
LOKI_PORT=3101
JAEGER_UI_PORT=16686
JAEGER_OTLP_PORT=4317
JAEGER_COLLECTOR_PORT=14268
WAZUH_SYSLOG_PORT=1514
WAZUH_API_PORT=55000

# ─── DevSecOps ────────────────────────────────────────────
GITEA_HTTP_PORT=3300
GITEA_SSH_PORT=2222
SONARQUBE_PORT=9900
POSTAL_SMTP_PORT=25
RADICALE_PORT=5232

# ─── AI/ML ────────────────────────────────────────────────
MLFLOW_PORT=5050
MLFLOW_BACKEND_STORE=postgresql://mlflow_user:<CHANGE_ME>@pg-analytics:5435/mlflow_db
MLFLOW_ARTIFACT_ROOT=s3://ml-models
TF_SERVING_REST_PORT=8501
TF_SERVING_GRPC_PORT=8500

# ─── OpenTelemetry ────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317

# ─── Service Ports (Python) ──────────────────────────────
PATIENT_SERVICE_PORT=3001
CLINICAL_SERVICE_PORT=3002
DIAGNOSTICS_SERVICE_PORT=3003
PHARMACY_SERVICE_PORT=3004
NURSING_SERVICE_PORT=3005
OT_SERVICE_PORT=3006
ICU_SERVICE_PORT=3007
BLOOD_BANK_SERVICE_PORT=3008
INFECTION_CONTROL_SERVICE_PORT=3009
MEDICAL_RECORDS_SERVICE_PORT=3010
AI_SERVICE_PORT=3011
DEVICES_SERVICE_PORT=3012
IAM_SERVICE_PORT=5001
ZTA_SERVICE_PORT=5002
ANALYTICS_SERVICE_PORT=5003
THREAT_DETECTION_SERVICE_PORT=5004

# ─── Service Ports (Node.js) ─────────────────────────────
GATEWAY_SERVICE_PORT=4001
APPOINTMENT_SERVICE_PORT=4002
BILLING_SERVICE_PORT=4003
INVENTORY_SERVICE_PORT=4004
HR_SERVICE_PORT=4005
FACILITIES_SERVICE_PORT=4006
ER_SERVICE_PORT=4007
BED_MANAGEMENT_SERVICE_PORT=4008
ORDER_SERVICE_PORT=4009
TELEMEDICINE_SERVICE_PORT=4010
NOTIFICATION_SERVICE_PORT=4011
MANAGEMENT_SERVICE_PORT=4012
MARKETING_SERVICE_PORT=4013
LEGAL_SERVICE_PORT=4014
COMPLIANCE_SERVICE_PORT=4015
AUDIT_SERVICE_PORT=4016
TRANSPLANT_SERVICE_PORT=4017

# ─── Frontend ─────────────────────────────────────────────
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
