KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASS=admin

# ZTA Service
ZTA_SERVICE_URL=http://zta-service:8012

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=iam-service

# Security
PQC_SESSION_HEADER=X-PQC-Session-Key
RP_ID=medtrustx.internal
RP_NAME="MedTrustX DHOS"
