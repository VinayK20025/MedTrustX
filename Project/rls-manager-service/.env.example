# Application
ENVIRONMENT=development
SERVICE_PORT=8011
SERVICE_NAME=rls-manager-service
SERVICE_VERSION=1.0.0

# Security (PQC+JWT)
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=medtrustx
PQC_ENABLED=true
PQC_KYBER_PUBLIC_KEY_PATH=/run/secrets/pqc_kyber_public.key
PQC_SESSION_HEADER=X-PQC-Session-Key

# Redis
REDIS_URL=redis://:redis_secret_2026@medtrust-redis:6379/0

# Observability
LOKI_URL=http://medtrust-loki:3100/loki/api/v1/push
OTEL_EXPORTER_OTLP_ENDPOINT=http://medtrust-jaeger:4317
PROMETHEUS_METRICS_PATH=/metrics

# Databases
CLINICAL_DB_URL=postgresql+asyncpg://medtrust_clinical_admin:clinical_db_secret_2026@medtrust-pg-clinical:5432/patients_db
OPERATIONAL_DB_URL=postgresql+asyncpg://medtrust_ops_admin:operational_db_secret_2026@medtrust-pg-operational:5433/scheduling_db
IAM_DB_URL=postgresql+asyncpg://medtrust_iam_admin:iam_db_secret_2026@medtrust-pg-iam:5434/iam_db
ANALYTICS_DB_URL=postgresql+asyncpg://medtrust_analytics_admin:analytics_db_secret_2026@medtrust-pg-analytics:5435/analytics_db
