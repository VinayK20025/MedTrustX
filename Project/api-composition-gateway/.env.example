# API
API_COMPOSITION_GATEWAY_PORT=8022
API_COMPOSITION_GATEWAY_WORKERS=4

# PostgreSQL
OPERATIONAL_DB_URL=postgresql+asyncpg://medtrust_ops_admin:operational_db_secret_2026@pg-operational:5433/scheduling_db

# Redis
REDIS_URL=redis://:redis_secret_2026@medtrust-redis:6379/0

# Keycloak
