# ============================================================
# MedTrustX Device Trust Agent — Environment Configuration
# Copy this file to .env and fill in all values before running
# NEVER commit .env to version control
# ============================================================

# ── Agent Identity ─────────────────────────────────────────────────────────
# Unique device identifier — assigned during registration
AGENT_DEVICE_ID=

# Tenant identifier for multi-tenant deployment
AGENT_TENANT_ID=

# Agent version — do not modify manually
AGENT_VERSION=1.0.0

# Agent mode: native or browser
AGENT_MODE=native

# ── ZTA Service ────────────────────────────────────────────────────────────
# Primary attestation reporting endpoint
ZTA_SERVICE_URL=http://zta-service:8012

# mTLS certificate for authenticating to ZTA service
ZTA_SERVICE_CERT_PATH=/etc/medtrustx/certs/device.pem
ZTA_SERVICE_KEY_PATH=/etc/medtrustx/certs/device.key

# JWT signing key for device authentication
ZTA_SERVICE_JWT_SECRET=

# Maximum retry attempts for ZTA reporting
ZTA_RETRY_ATTEMPTS=3

# Backoff multiplier in seconds between retries
ZTA_RETRY_BACKOFF_SECONDS=2

# ── SIEM / Syslog ──────────────────────────────────────────────────────────
# RFC 5424 UDP syslog target
SIEM_HOST=medtrust-siem
SIEM_PORT=514

# CEF vendor/product metadata
SIEM_DEVICE_VENDOR=MedTrustX
SIEM_DEVICE_PRODUCT=DeviceTrustAgent
SIEM_DEVICE_VERSION=1.0

# ── Prometheus Pushgateway ─────────────────────────────────────────────────
PROMETHEUS_PUSHGATEWAY_URL=http://pushgateway:9091
PROMETHEUS_JOB_NAME=device-trust-agent
# Push interval in seconds
PROMETHEUS_PUSH_INTERVAL_SECONDS=60

# ── OPA Policy Engine ──────────────────────────────────────────────────────
OPA_SERVICE_URL=http://opa-service:8181
OPA_DEVICE_DATA_PATH=/v1/data/medtrustx/devices

# ── IAM Database (for behavioral check) ────────────────────────────────────
IAM_DB_HOST=iam-db
IAM_DB_PORT=5432
IAM_DB_NAME=iam_db
IAM_DB_USER=iam_agent
IAM_DB_PASSWORD=
IAM_DB_SSL_MODE=require
IAM_DB_SSL_CERT=/etc/medtrustx/certs/db-client.pem
IAM_DB_SSL_KEY=/etc/medtrustx/certs/db-client.key
IAM_DB_SSL_CA=/etc/medtrustx/certs/db-ca.pem

# ── Certificate / PKI ──────────────────────────────────────────────────────
# Path to MedTrustX Root CA certificate (embedded in agent bundle)
ROOT_CA_CERT_PATH=/etc/medtrustx/certs/medtrustx-root-ca.pem

# Device certificate issued by MedTrustX PKI
DEVICE_CERT_PATH=/etc/medtrustx/certs/device.pem
DEVICE_KEY_PATH=/etc/medtrustx/certs/device.key

# OCSP responder URL (read from cert extension if empty)
OCSP_RESPONDER_URL=

# ── Network Security ───────────────────────────────────────────────────────
# Corporate network CIDR range (trusted)
CORPORATE_NETWORK_CIDR=10.0.0.0/8

# Approved DNS servers (comma-separated)
APPROVED_DNS_SERVERS=10.0.0.53,10.0.1.53

# VPN process/interface name pattern
VPN_PROCESS_NAME=medtrustx-vpn
VPN_INTERFACE_PREFIX=tun,wg,utun

# ── On-Demand Handler ──────────────────────────────────────────────────────
# Local-only listener for ZTA-triggered on-demand checks
# MUST remain 127.0.0.1 — never change to 0.0.0.0
ON_DEMAND_BIND_HOST=127.0.0.1
ON_DEMAND_BIND_PORT=9099

# ── Scheduler Intervals (seconds) ─────────────────────────────────────────
CHECK_INTERVAL_TRUSTED=120
CHECK_INTERVAL_STANDARD=60
CHECK_INTERVAL_RESTRICTED=30
CHECK_INTERVAL_BLOCKED=15

# ── Logging ────────────────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log output: json or console
LOG_FORMAT=json

# Log file path (empty = stdout only)
LOG_FILE_PATH=/var/log/medtrustx/agent.log

# ── Whitelisted Applications ───────────────────────────────────────────────
# Comma-separated list of whitelisted RAT tools (e.g., corporate TeamViewer)
WHITELISTED_RAT_PROCESSES=

# Comma-separated list of additional whitelisted processes
WHITELISTED_PROCESSES=

# ── Fingerprint Registration ───────────────────────────────────────────────
# Stored device fingerprint hash (set during initial registration)
DEVICE_FINGERPRINT_HASH=

# Install timestamp (UTC ISO format, set once at installation)
DEVICE_INSTALL_DATE=
